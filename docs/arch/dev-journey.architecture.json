  "cards": [
    {
      "dot": "cyan",
      "title": "Where to start",
      "items": [
        "No idea what's wrong → dev:survey",
        "Already know → dev:create-* files it",
        "Board already stocked → dev:issues, or bare /dev"
      ]
    },
    {
      "dot": "emerald",
      "title": "What each door needs",
      "items": [
        "survey · create-* — a description. No branch yet",
        "dev #N — an issue number. Cuts the branch",
        "verify · pre-prod — a branch · docs — a diff · review — a PR number"
      ]
    },
    {
      "dot": "violet",
      "title": "The only automatic hop",
      "items": [
        "verify (11) → docs (12) chains without asking",
        "Everything else stops and asks",
        "Nothing ever chains into a merge or a promotion"
      ]
    },
    {
      "dot": "rose",
      "title": "Phase 13 is not a door",
      "items": [
        "/code-review is a plugin, not a dev:* member",
        "It is 20 lines that say run it — so run it",
        "dev:prod is the only door that reaches production"
      ]
    }
  ]
