 "cards": [
  {
   "dot": "cyan",
   "title": "Step 1 — /dev orients",
   "items": [
    "Work in flight → resume it (branch, phase, what is next)",
    "Board stocked → dev:kanban, then pick one",
    "Code but empty tracker → dev:survey · dev:ideation · dev:roadmap",
    "Fresh project → /dev <description>. Read-only until you choose"
   ]
  },
  {
   "dot": "emerald",
   "title": "What each door needs",
   "items": [
    "survey · create-* — a description. No branch yet",
    "dev #N — an issue number. Cuts the branch",
    "verify · pre-prod — a branch · docs — a diff · review — a PR number"
   ]
  },
  {
   "dot": "violet",
   "title": "The only automatic hop",
   "items": [
    "verify (11) → docs (12) chains without asking",
    "Everything else stops and asks",
    "Nothing ever chains into a merge or a promotion"
   ]
  },
  {
   "dot": "rose",
   "title": "A survey issue is half-investigated",
   "items": [
    "Its ## Suspected names the run and the date",
    "Layers 1–2 done: two checkers, against the CODE",
    "Layers 3–5 still run — survey never launches the app"
   ]
  }
 ]
