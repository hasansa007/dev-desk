          "desk",
          "devrun",
          "agent",
          "state",
          "screens"
        ],
        "note": "A click in Dev Desk becomes dev run's built prompt, an agent in the task folder, and a phase checkpoint."
      },
      {
        "id": "run-a-door",
        "label": "Run a door",
        "focus": [
          "cli",
          "contract",
          "door",
          "agent"
        ],
        "note": "A typed /dev door: the agent loads the shared contract, then the door's own phases, then executes them."
      },
      {
        "id": "draw-a-diagram",
        "label": "Draw a diagram",
        "focus": [
          "agent",
          "docs",
          "screens"
        ],
        "note": "dev:arch writes the HTML and its IR sidecar into docs/arch/; the Diagrams screen lists what it finds."
      },
      {
        "id": "read-the-board",
        "label": "Read the board",
        "focus": [
          "state",
          "tracker",
          "board",
          "screens"
        ],
        "note": "dev board and Dev Desk read the same issues, pull requests and .dev state, and are meant to agree."
      },
      {
        "id": "file-an-issue",
        "label": "File an issue",
        "focus": [
          "agent",
          "tracker",
          "board"
        ],
        "note": "The create-* doors write to the tracker, which is what the next run reads back as its input."
      }
    ]
