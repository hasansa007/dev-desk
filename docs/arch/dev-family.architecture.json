  "cards": [
    {
      "dot": "cyan",
      "title": "Two kinds of door",
      "items": [
        "Phases take a durable artifact — branch, diff, PR number",
        "Tools map to no phase and run none of the pipeline",
        "Phases 1–8 pass reasoning, which has no artifact to hand on"
      ]
    },
    {
      "dot": "amber",
      "title": "What each tool loads",
      "items": [
        "launch · launch-kill · shots — nothing",
        "issues — Universal Rules only",
        "trim · arch — Guiding Principles + Universal Rules",
        "survey — those plus Right-Size, the widest fan-out"
      ]
    },
    {
      "dot": "violet",
      "title": "The one wired pair",
      "items": [
        "verify (11) → docs (12) chains without asking",
        "Same diff, both read-only, two halves of one PR body",
        "Nothing ever chains into a merge or a promotion"
      ]
    },
    {
      "dot": "rose",
      "title": "Deliberately absent",
      "items": [
        "Phase 13 is /code-review — 20 lines that say run it",
        "launch-kill and shots read launch's discovery, not the pipeline",
        "Archify is the family's only third-party dependency"
      ]
    }
  ]
