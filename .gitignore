.DS_Store

# docs/ IS tracked: the docs gate requires an ADR to be part of the diff that
# introduces the decision, which an ignored path can never be.

# Third-party agent framework working directory — not part of this family, holds credentials.
.auto-claude/

# Per-machine Claude Code settings, not project config: the file here holds only
# outputStyle, which is a local editor preference and differs per clone.
.claude/settings.local.json

# Everything the dev CLI generates: per-branch pipeline state.
# Machine-local; git is authoritative. The CLI also writes .dev/.gitignore, so repos without
# this line stay clean too.
.dev/

# Dev Desk's record of what was running in this repo, kept so a killed app can be recovered from (ADR 0031).
# run.json is the exception: it is the project's own Run configuration, committed so every clone and worktree runs the same way.
.devdesk/*
!.devdesk/run.json

# SwiftPM and xcodebuild output under the Mac app. Build artifacts, never source.
apps/desk/build/
apps/desk/DeskCore/build/

# The hook bypass is a local, per-session escape hatch — never a repo state.
.claude/hooks-off

# Stray visual-check run artifacts (a failed Chrome inspection log, written at the repo root).
*.visual-check.json

# Generated icon previews. `apps/desk/icon/make-appicon.py` writes these beside the source art on
# its way to Assets.xcassets, which is the copy that ships and the copy check-appicon.py reads.
apps/desk/icon/AppIcon-1024.png
apps/desk/icon/AppIcon-dark-1024.png

# Icon export scratch. Nothing in the repo reads this path.
/output/

# Workflow viewer artifacts, written at the repo root by whatever ran last.
dev-task-start.html
dev-task-start.workflow.json
